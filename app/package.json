  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
