# Hippo configuration. Copy to infra/.env (never committed) and fill in the secrets:
#   cp infra/.env.example infra/.env
# Docker Compose reads infra/.env from this folder; `make dev` loads it for the local backend.
# Every value below is a fake placeholder.

# --- Backend (docker-compose.yml, docker-compose.local.yml, make dev) -------------------------

# Static API token shared with the app (ADR-0016). At least 32 bytes, random:
#   openssl rand -hex 32
# Changing it needs a rebuild of the app, which embeds it. Left empty on purpose: the backend
# refuses to start until it is set, so a copied example never runs with a public token.
API_TOKEN=

# Anthropic API key dedicated to Hippo, on prepaid credits without auto-reload (ADR-0021).
# Optional: left empty, the backend starts, logs a warning and the nightly analysis sends nothing
# (phase 1 of docs/runbook-nas.md).
ANTHROPIC_API_KEY=

# Claude model used by the analysis (ADR-0005).
ANALYSIS_MODEL=claude-haiku-4-5

# Standard prices of ANALYSIS_MODEL, in US dollars per million input and output tokens; update
# them with the model (RG-80). The batch discount (half price) and the cache ratios are applied
# in code. Defaults: Claude Haiku 4.5, checked on 2026-11-07 at
# https://platform.claude.com/docs/en/about-claude/pricing. A value that is not a positive
# number stops the start-up.
ANALYSIS_INPUT_PRICE_USD_PER_MTOK=1
ANALYSIS_OUTPUT_PRICE_USD_PER_MTOK=5

# Nightly batch schedule (RG-30): daily form "M H * * *" only (minute 0-59, hour 0-23), in
# Europe/Paris time whatever TZ says (the binary embeds the time zone database). Any other form
# (lists, ranges, steps, a day field) is refused and stops the start-up.
# Quoted: the file is read by Compose and sourced by `make dev`.
BATCH_SCHEDULE="0 2 * * *"

# Nightly backup schedule (ADR-0020). Read but not used yet: the backup (E6-03, change
# nightly-backup) will fix its form.
BACKUP_SCHEDULE="0 3 * * *"

# Monthly AI budget in US dollars; once reached, no analysis until the 1st of next month (RG-81).
MONTHLY_BUDGET_USD=5

# Minimum level of the JSON logs: debug, info, warn or error.
LOG_LEVEL=info

# Time zone of the container. Only the timestamps of the logs follow it (the Go runtime reads TZ
# for the local time). BATCH_SCHEDULE and every date of the domain are always Paris time,
# whatever TZ says.
TZ=Europe/Paris

# Fixed by the image, by docker-compose.yml (HTTP_ADDR) and by `make dev` on its command line:
# never put them in this file, where they would have no effect.
# HTTP_ADDR=:8080        listen address of the backend
# DATA_DIR=/data         SQLite database and images (the ./data volume)

# --- NAS only (docker-compose.yml) ----------------------------------------------------------
# Step by step: docs/runbook-nas.md. On the NAS, this file is in mode 600; its secrets are kept
# in the password manager, never in the repository.
# The NAS gets its own API_TOKEN (above), generated for it, never the Mac's: the app built for
# the NAS embeds it, and a token leaked on the Mac does not open the NAS.

# Tailscale auth key that enrols the "hippo" node once (ADR-0015), created in the Tailscale
# admin console: one-off (not reusable), pre-approved when device approval is on, not
# ephemeral, no tag (no ACL change).
# With TS_AUTH_ONCE, the key is only used while ./tailscale/state holds no node: once the node
# is enrolled, erase the consumed key from this file (leave TS_AUTHKEY= empty), then disable key
# expiry on the node in the admin console.
TS_AUTHKEY=tskey-auth-replace-me

# Image tag pulled from GHCR, required by docker-compose.yml. On the NAS, pin an existing
# sha-<short sha> tag (read on the GHCR package page, checked with docker manifest inspect), to
# update or roll back deliberately; latest is acceptable on the Mac only.
HIPPO_IMAGE_TAG=latest

# --- App build (shell that runs `make app` or `npx expo run:ios`, not Compose) ---------------

# Injected into the app and the share extension at build time (ADR-0014). On the simulator,
# the local backend; on the iPhone, the tailnet address published by tailscale serve.
# HIPPO_API_URL=http://127.0.0.1:8080
# HIPPO_API_TOKEN=<same value as API_TOKEN>
