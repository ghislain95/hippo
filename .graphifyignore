# graphify exclusions (.gitignore syntax). node_modules, build outputs and graphify-out are
# already excluded through .gitignore. The graph holds code only, so it stays deterministic.

# Lockfiles: huge, low value.
package-lock.json

# Agent tooling: the skills' documentation is not code.
.claude/

# Markdown: without a semantic pass, a Markdown file only yields title nodes with no edge to
# the code — a partial, misleading index. Docs are read directly (grep, Read).
**/*.md

# Generated code: regenerated from api/openapi.yaml and docs/prompt/schemas/, it would only
# add hub nodes that hide the hand-written code.
*.gen.go
*.gen.ts
backend/internal/analysis/schema/

# Native folders generated by `expo prebuild`.
app/ios/
app/android/
