# Secrets: never commit. Only the documented example is versioned.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.mobileprovision

# Runtime data (SQLite database, images, backups, Tailscale state)
data/
infra/data/
infra/tailscale/state/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.iml

# Go
backend/bin/
*.test
*.out
coverage.*

# Node
node_modules/
npm-debug.log*

# Expo / React Native (native folders are generated by `expo prebuild`)
app/.expo/
app/dist/
app/web-build/
app/ios/
app/android/
app/coverage/
# Outputs of make build-ios-sim and make ipa (app/scripts/)
app/build/
# Swift package of the share extension (swift test) and its build-time configuration, which holds
# the token (app/plugins/with-share-config.js, ADR-0027)
app/targets/.build/
app/targets/.swiftpm/
app/targets/share/*.generated.swift
# Colour sets written at prebuild from app/src/ui/theme/tokens.json (design D10).
app/targets/share/Assets.xcassets/
*.jks
*.keystore

# Logs
*.log

# graphify knowledge graph: rebuilt locally, never committed
graphify-out/

# Claude Code: per-machine state (settings.local.json holds the GH_TOKEN)
/.claude/settings.local.json
/.claude/passation/
/.claude/worktrees/
